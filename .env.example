# Local demo only. Change these before exposing SI beyond localhost.
POSTGRES_PASSWORD=si-local-postgres
SI_BOOTSTRAP_KEY=si-local-development
SI_API_KEY=si-local-development
SI_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Optional providers. The default mock requires no external credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
EMBEDDING_MODEL=

# Opt-in outbound tools: only explicitly allowed public hosts may be fetched.
HTTP_ALLOWED_HOSTS=
SI_MCP_SERVERS={}
SI_ENABLE_PYTHON_TOOL=false
SI_RATE_LIMIT=120
SI_MONTHLY_TOKENS=1000000
SI_MONTHLY_COST=100
SI_CACHE_TTL=300
